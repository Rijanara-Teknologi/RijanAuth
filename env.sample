# True in development, False in production
DEBUG=True

FLASK_APP=run.py
FLASK_DEBUG=1

# If not provided, a random one is generated 
# SECRET_KEY=<YOUR_SUPER_KEY_HERE>

# -----------------------------------------------------------------------
# SQLite database file path.
# Set this to a path on a mounted Docker volume or host bind-mount so the
# database survives container rebuilds.
# Default inside Docker (Dockerfile sets ENV DB_PATH=/data/db.sqlite3):
#   DB_PATH=/data/db.sqlite3
# -----------------------------------------------------------------------
# DB_PATH=/data/db.sqlite3

# -----------------------------------------------------------------------
# Sentry Error Tracking (optional)
# Get your DSN from https://sentry.io
# Auto-activates when SENTRY_DSN is set
# -----------------------------------------------------------------------
# SENTRY_DSN=https://xxx@sentry.io/xxx
# ENVIRONMENT=production
# SENTRY_SAMPLE_RATE=1.0  # 100% of errors captured
# SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% of transactions for performance monitoring

# Used for CDN (in production)
# No Slash at the end
ASSETS_ROOT=/static/assets

# SOCIAL AUTH Github
# GITHUB_ID=YOUR_GITHUB_ID
# GITHUB_SECRET=YOUR_GITHUB_SECRET
